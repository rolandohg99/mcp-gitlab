# Instancia de GitLab (sin barra final)
GITLAB_URL=https://project.comsatel.com.pe

# Personal Access Token con scope `api`
# GitLab > Preferences > Access Tokens > Add new token
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Opcional: proyecto por defecto (path con namespace o ID numerico)
# Evita tener que repetirlo en cada llamada.
GITLAB_DEFAULT_PROJECT=

# Puerto del dashboard local (opcional)
DASHBOARD_PORT=5178

# Grupo raíz de los productos (opcional). Cada subgrupo de primer nivel es un
# producto; el panel detecta en cuáles trabajas por tu actividad reciente.
# PRODUCTS_GROUP=comsatel/development/products

# Fija los productos a mano, por slug y separados por coma (opcional).
# Sin definir, se detectan solos.
# DASHBOARD_PRODUCTS=sigo,comunes

# Repos vigilados en el panel de pipelines, separados por coma (opcional).
# Tiene prioridad sobre los productos.
DASHBOARD_PROJECTS=

# Grupo fijo para el reporte de horas (opcional). Sin definir, se leen las
# horas de los productos detectados. Definirlo limita las horas a ese grupo.
# TIMELOG_GROUP=comsatel/development/products/sigo

# Hora del recordatorio de registro de horas (HH:MM, dias laborables)
HORA_AVISO=17:30

# Zona horaria de la jornada: define "hoy", la semana y la hora del aviso,
# también en Vercel, que corre en UTC (IANA, opcional)
ZONA_HORARIA=America/Lima

# Minutos entre revisiones en segundo plano
POLL_MINUTES=5

# --- App web multiusuario (npm run web) ---
# Cada persona entra con su propio token de acceso personal (scope read_api):
# no hace falta registrar ninguna aplicación en GitLab.
WEB_PORT=5179

# --- Aviso de versiones nuevas (sin infraestructura) ---
# La app lee este manifiesto de GitLab con el token del propio usuario.
UPDATE_PROJECT=comsatel/development/products/collaboration
UPDATE_PATH=panel-desarrollo/version.json
UPDATE_REF=main

# --- Kubernetes de QA (a través del bastión por SSH) ---
# Sin K8S_SSH_HOST, las herramientas de Kubernetes no se registran.
#
# MODO SOLO LECTURA: por defecto activo. Las herramientas que modifican el
# clúster (reiniciar, escalar, borrar, aplicar, rollback, kubectl_crudo) se
# niegan a ejecutarse. Las simulaciones --dry-run sí funcionan.
# Para operar de verdad hay que poner exactamente "false" y reiniciar.
K8S_SOLO_LECTURA=true

K8S_SSH_HOST=
K8S_SSH_PORT=22
K8S_SSH_USER=
# Autenticación: contraseña O clave privada (la clave es preferible)
K8S_SSH_PASSWORD=
K8S_SSH_KEY_PATH=
K8S_SSH_KEY_PASSPHRASE=
# Tiempo máximo por comando, en milisegundos
K8S_SSH_TIMEOUT_MS=45000
